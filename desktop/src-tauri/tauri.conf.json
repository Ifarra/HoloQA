{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HoloQA Desktop",
  "version": "0.1.0",
  "identifier": "com.holoqa.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label":"main","title":"HoloQA Desktop","width":1440,"height":1000,"minWidth":800,"minHeight":650,"backgroundColor":"#09080f"}],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "capabilities": [{"identifier":"main","windows":["main"],"permissions":["core:default"]}]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/holoqa-desktop-engine"],
    "icon": ["icons/icon.ico"],
    "windows": {"webviewInstallMode":{"type":"downloadBootstrapper"},"nsis":{"installMode":"currentUser"}}
  }
}
