FROM node:22-alpine
WORKDIR /app
COPY package.json ./
RUN npm install --no-audit --no-fund
ARG HOLOQA_API_URL=http://localhost:8000
ENV HOLOQA_API_URL=$HOLOQA_API_URL
COPY app ./app
COPY components ./components
COPY lib ./lib
COPY next.config.mjs tsconfig.json next-env.d.ts ./
RUN npm run build
EXPOSE 3001
CMD ["npm", "run", "start"]
